# ogrep environment configuration
# Copy this file to .env and fill in your values

# Required: OpenAI API key for embeddings
OPENAI_API_KEY=sk-your-key-here

# Optional: Custom embedding model (default: text-embedding-3-small)
# OGREP_MODEL=text-embedding-3-small

# Optional: Custom embedding dimensions (model-dependent)
# OGREP_DIMENSIONS=1536
